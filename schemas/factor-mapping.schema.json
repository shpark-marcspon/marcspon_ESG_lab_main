{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esg-lab.local/schemas/factor-mapping.schema.json",
  "title": "계수 조립용 대응표",
  "description": "계수 레코드(factor.schema.json)의 낱줄을 지침의 규칙대로 묶을 때 쓰는 기준정보. 값 하나짜리 레코드가 아니라 이름·코드·등급의 대응이다. py/factors 가 원자료에서 만들어 data/factors/mappings.kr-ets.json 에 쓴다. basis 가 assumed 인 항목은 지침에 없는 추정 대응이고, 쓰는 쪽은 그 대응을 탔다는 것을 결과의 근거에 남겨야 한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "guideline", "sources", "sectors", "sector_overlaps", "fuel_names", "fuel_states", "tier_minimums"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "guideline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "url"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1, "description": "고시 번호와 시행일"},
        "url": {"type": "string", "pattern": "^https?://\\S+$"}
      }
    },
    "sources": {
      "type": "object",
      "description": "source_id → 원자료. 아래 항목의 source_id 는 전부 여기에 있어야 한다",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "publisher", "url", "version", "retrieved", "file_name", "file_sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://\\S+$"},
          "version": {"type": "string", "minLength": 1},
          "retrieved": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "원자료를 내려받아 확인한 날"},
          "file_name": {"type": "string", "minLength": 1},
          "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "sectors": {
      "type": "array",
      "description": "CH4·N2O 기본 배출계수를 가르는 부문과 그 부문에 드는 한국표준산업분류 중분류 코드",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "ksic_divisions", "ch4_condition", "n2o_condition", "codes_raw", "source_id", "locator"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z_]+$", "description": "조립 조건과 계산 엔진이 쓰는 부문 키"},
          "label": {"type": "string", "minLength": 1, "description": "원문의 부문 이름"},
          "ksic_divisions": {
            "type": "array",
            "description": "중분류 코드(두 자리). 원문의 범위 표기를 낱개로 편 것. 한 코드가 두 부문에 들 수 있다 (sector_overlaps)",
            "items": {"type": "string", "pattern": "^\\d{2}$"},
            "minItems": 1,
            "uniqueItems": true
          },
          "ch4_condition": {"type": "string", "minLength": 1, "description": "계수 레코드의 conditions.부문 값 가운데 이 부문의 CH4 열"},
          "n2o_condition": {"type": "string", "minLength": 1, "description": "계수 레코드의 conditions.부문 값 가운데 이 부문의 N2O 열"},
          "codes_raw": {"type": "string", "minLength": 1, "description": "원문의 코드 표기 그대로 (공백 없음)"},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "sector_overlaps": {
      "type": "array",
      "description": "원문에서 두 부문에 같이 적힌 중분류 코드. 중분류 코드만으로는 부문을 정할 수 없다. exceptions 는 원문 주석이 더 자세한 코드로 부문을 정해 준 경우다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["division", "sectors", "exceptions", "source_id", "locator"],
        "properties": {
          "division": {"type": "string", "pattern": "^\\d{2}$"},
          "sectors": {"type": "array", "items": {"type": "string", "pattern": "^[a-z_]+$"}, "minItems": 2, "uniqueItems": true},
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code_prefix", "sector", "raw"],
              "properties": {
                "code_prefix": {"type": "string", "pattern": "^\\d{3,5}$", "description": "이 숫자로 시작하는 업종 코드"},
                "sector": {"type": "string", "pattern": "^[a-z_]+$"},
                "raw": {"type": "string", "minLength": 1, "description": "원문 주석에서 읽은 자리 (공백 없음)"}
              }
            }
          },
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "fuel_names": {
      "type": "array",
      "description": "국내 연료 이름 → 별표 10(배출계수)·별표 11(발열량)의 IPCC 연료 이름. 표마다 따로 적는다",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "ipcc_name", "domestic_names", "domestic_raw", "basis", "note", "source_id", "locator"],
        "properties": {
          "table": {"type": "string", "minLength": 1, "description": "그 IPCC 이름이 있는 계수 출처 id"},
          "ipcc_name": {"type": "string", "minLength": 1, "description": "계수 레코드의 name.original"},
          "domestic_names": {
            "type": "array",
            "description": "이 IPCC 연료에 대응하는 국내 이름. 비어 있으면 원문 칸을 이름으로 가르지 못한 것이다 (note 에 까닭)",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "domestic_raw": {"type": ["string", "null"], "description": "원문 「국내에너지원 기준」 칸 그대로. 추정 항목은 null"},
          "basis": {"enum": ["guideline", "assumed"], "description": "guideline: 지침의 표에 있는 대응. assumed: 지침에 없는 추정"},
          "note": {"type": ["string", "null"]},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "parameters": {
            "type": "array",
            "description": "있으면 이 대응은 이 매개변수(별표 10 의 기체)에만 쓰인다. 없으면 그 표의 모든 매개변수에 쓰인다",
            "items": {"enum": ["CO2", "CH4", "N2O", "calorific"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "description": "추정의 근거 문장 자리. quote 는 그 출처의 그 쪽 글자에 (공백을 뺀 채로) 있다. 적재 때 확인한다",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "locator", "quote"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "locator": {"type": "string", "pattern": "^PDF \\d+쪽$"},
                "quote": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "national_ef_names": {
      "type": "array",
      "description": "별표 12 안에서 발열량 표의 이름(조립 조건의 연료명) → 배출계수 표의 이름. 두 표가 같은 연료를 다르게 적을 때만 둔다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fuel", "ef_name", "basis", "note", "source_id", "locator"],
        "properties": {
          "fuel": {"type": "string", "minLength": 1, "description": "별표 12 발열량 표의 이름"},
          "ef_name": {"type": "string", "minLength": 1, "description": "별표 12 배출계수 표의 이름 (계수 레코드의 name.original)"},
          "basis": {"enum": ["guideline", "assumed"]},
          "note": {"type": ["string", "null"]},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    },
    "fuel_states": {
      "type": "array",
      "description": "연료 → 고체·기체·액체. 별표 6 의 어느 고정연소 절을 따르는지, 곧 산화계수를 정한다",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fuel", "state", "basis", "quote", "note", "source_id", "locator"],
        "properties": {
          "fuel": {"type": "string", "minLength": 1},
          "state": {"enum": ["고체", "기체", "액체"]},
          "basis": {"enum": ["guideline", "assumed"]},
          "quote": {"type": "string", "minLength": 1, "description": "근거 문장. 원자료에 있는지 적재 때 확인한다"},
          "note": {"type": ["string", "null"]},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "description": "별표 6 밖의 근거 자리 (별표 12 의 분류 등). quote 는 그 출처의 그 쪽 글자에 (공백을 뺀 채로) 있다. 적재 때 확인한다",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "locator", "quote"],
              "properties": {
                "source_id": {"type": "string", "minLength": 1},
                "locator": {"type": "string", "pattern": "^PDF \\d+쪽$"},
                "quote": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "tier_minimums": {
      "type": "array",
      "description": "시설 규모 그룹별, 매개변수별 최소 산정등급 (별표 5)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activity", "fuel_state", "parameter", "group", "tier", "source_id", "locator"],
        "properties": {
          "activity": {"const": "고정연소"},
          "fuel_state": {"enum": ["고체", "기체", "액체"]},
          "parameter": {"enum": ["산정방법론", "연료사용량", "순발열량", "배출계수", "산화계수"]},
          "group": {"enum": ["A", "B", "C"]},
          "tier": {"type": "integer", "minimum": 1, "maximum": 4},
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "description": "추정 항목은 까닭(note)을 적는다",
      "properties": {
        "fuel_names": {"items": {"if": {"properties": {"basis": {"const": "assumed"}}}, "then": {"properties": {"note": {"type": "string", "minLength": 1}, "domestic_raw": {"type": "null"}}}}},
        "fuel_states": {"items": {"if": {"properties": {"basis": {"const": "assumed"}}}, "then": {"properties": {"note": {"type": "string", "minLength": 1}}}}},
        "national_ef_names": {"items": {"if": {"properties": {"basis": {"const": "assumed"}}}, "then": {"properties": {"note": {"type": "string", "minLength": 1}}}}}
      }
    }
  ]
}
